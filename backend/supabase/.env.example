# Supabase Edge Function secrets — NEVER commit real values.
# Set with:  supabase secrets set IP_SALT=...  (per project)
# or in the Supabase dashboard: Project Settings -> Edge Functions -> Secrets.

# Random per-project salt used to hash IPs before storage. IPs are NEVER stored raw.
# Generate:  openssl rand -hex 32
IP_SALT=change-me-to-a-random-32-byte-hex-string

# Optional: Cloudflare Turnstile secret (only needed if you enable CAPTCHA on a poll).
TURNSTILE_SECRET=

# These are injected automatically by Supabase for edge functions; listed for clarity.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
